}
h2{
  color:var(--rust);
  font-size:21px;
  margin-top:0;
  border-bottom:1px solid #e7d9bd;
  padding-bottom:8px;
}
h3{color:var(--olive)}
.artwork{
  display:block;
  width:min(100%,690px);
  margin:15px auto;
  border-radius:8px;
  box-shadow:0 8px 25px #0002;
}
.label-image{
  display:block;
  width:min(100%,470px);
