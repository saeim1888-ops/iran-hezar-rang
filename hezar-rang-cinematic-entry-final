 background:radial-gradient(circle at 36% 28%,#fff 0 28%,#f4f0e9 62%,#c9c1b5 100%);
 border:1px solid #d8cfc0;box-shadow:0 5px 16px #160c0870, inset 0 0 9px #8c8175a0;
