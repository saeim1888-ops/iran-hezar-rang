<script>
const positions=[
 // چشم‌ها روی پارچهٔ سمت چپ؛ پراکنده و با اندازه‌های متفاوت
 [5,12,2.8],[15,20,5.3],[8,34,3.1],[23,42,2.4],[5,56,4.2],[17,68,2.6],[8,82,3.5],[23,91,2.2],
 // چشم‌ها روی پارچهٔ سمت راست
 [95,11,2.5],[84,18,5.1],[94,31,3.2],[77,39,2.5],[96,54,4.1],[84,66,2.7],[94,80,3.7],[76,90,2.4]
];
const eyeRoot=document.getElementById('eyes');
positions.forEach((p,i)=>{
 const eye=document.createElement('span'); eye.className='eye';
 eye.style.setProperty('--x',p[0]+'%'); eye.style.setProperty('--y',p[1]+'%'); eye.style.setProperty('--size',p[2]+'%');
 eye.style.setProperty('--float',(4.4+(i%5)*.55)+'s'); eye.style.setProperty('--blinktime',(5.8+(i%6)*.8)+'s');
 const palettes=[['#8d6138','#c49a63','#5f432e'],['#617b65','#9aaf8d','#3e5847'],['#6d8294','#b2c4d1','#455d72'],['#9a7845','#c7a66c','#6e512f']];
 const colors=palettes[i%palettes.length];
 eye.innerHTML='<span class="iris"><i class="pupil"></i><i class="shine"></i></span>';
 const iris=eye.querySelector('.iris');
 iris.style.background=`repeating-radial-gradient(circle at 50% 50%,${colors[0]} 0 1px,${colors[1]} 1.5px 3px,${colors[2]} 3.5px 4.5px),radial-gradient(circle,#211a17 0 31%,${colors[1]} 34% 58%,${colors[2]} 68% 100%)`;
 eyeRoot.appendChild(eye);
});
const camera=document.getElementById('camera');
const approach=document.getElementById('approach');
const label=document.getElementById('entryLabel');
let entered=false;
function moveCamera(){
 const rect=approach.getBoundingClientRect();
 const range=Math.max(1,approach.offsetHeight-innerHeight);
 const p=Math.max(0,Math.min(1,-rect.top/range));
 const eased=p*p*p*(p*(p*6-15)+10);
 // دوربین رو به جلو زوم می‌کند؛ هم‌زمان دو لتهٔ پرده به طرفین باز می‌شوند.
 const scale=1+eased*1.18;
 const lift=-eased*2.5;
 camera.style.transform=`translate3d(0,${lift}%,0) scale(${scale})`;
 eyeRoot.style.opacity=String(Math.max(0,1-eased*.95));
 label.style.opacity=String(Math.max(0,1-p*2.0));
 if(p>.985 && !entered){
   entered=true;
   // عبور از آستانه؛ بدون مکث روی متن یا بخش معرفی
   document.body.classList.add('gallery-mode');
   window.scrollTo({top:0,behavior:'instant'});
 }
}
window.addEventListener('scroll',moveCamera,{passive:true});
window.addEventListener('resize',moveCamera);
moveCamera();
document.addEventListener('pointermove',e=>{
 document.querySelectorAll('.iris').forEach(iris=>{
  const r=iris.parentElement.getBoundingClientRect();
  const dx=(e.clientX-r.left-r.width/2)/Math.max(1,r.width);
  const dy=(e.clientY-r.top-r.height/2)/Math.max(1,r.height);
  iris.style.translate=`${Math.max(-6,Math.min(6,dx*10))}px ${Math.max(-6,Math.min(6,dy*10))}px`;
 });
});
</script>
